generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==============================================================
// Normalized CVI Registry Schema (Production — v2)
// ==============================================================

model Doctor {
  id                   Int          @id @default(autoincrement())
  email                String       @unique
  password             String
  name                 String
  role                 String       @default("radiologist")
  // Forces a password change before any other action — true for every newly
  // created account (see default below) and set true again whenever an admin
  // resets a forgotten password. Cleared only by a successful self-service
  // password change. Enforced server-side in middleware/requirePasswordSet.ts,
  // not just as a UI redirect.
  must_reset_password  Boolean      @default(true)
  created_at           DateTime     @default(now())
  updated_at           DateTime     @updatedAt
  assessments          Assessment[]
}

model Patient {
  id           String   @id @default(uuid())
  name         String
  uhid         String   @unique
  age          Int
  sex          String
  height       Float?
  weight       Float?
  bmi          Float?
  race         String?  // South Asian | Asian | Caucasian | African | Other
  smoking      String?  // JSON Array: Never, Former, Current
  occupation   String?  // JSON Array
  parity       Int?     // Female only
  dvt_history  Boolean  @default(false)
  clinic       String?
  doctor_notes String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  legs        Leg[]
  assessments Assessment[]
  auditLogs   AuditLog[]

  // NOTE: comorbidities, medications, venous_history, clinical_notes,
  // veines_notes have been MOVED to Assessment (per-visit data).
  // r_pain_vas / l_pain_vas have been MOVED to Leg.pain_vas (per-visit, per-leg).
}

model Assessment {
  id              String   @id @default(uuid())
  patient_id      String
  patient         Patient  @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  doctor_id       Int?     // FK to Doctor — nullable to avoid breaking existing records
  doctor          Doctor?  @relation(fields: [doctor_id], references: [id])
  assessment_date DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Per-Visit Medical History (moved from Patient)
  comorbidities  String? // JSON Array
  venous_history String? // JSON Array
  medications    String? // JSON Array (moved from Patient)

  // General Physical Exam (previously silently dropped — now saved)
  bp            String? // Blood Pressure e.g. "120/80 mmHg"
  pulse         Int?    // Pulse Rate in bpm
  general_signs String? // JSON Array: Pallor, Icterus, Clubbing, Cyanosis

  clinical_notes String?
  veines_notes   String? // VEINES-QOL notes

  // NOTE: right_pain_vas / left_pain_vas removed — pain_vas is per-leg (Leg.pain_vas).
  // NOTE: global_rvcss removed — computed on-the-fly in API responses.
  // NOTE: assessed_by removed — replaced by doctor_id FK.

  legs Leg[]
}

model Leg {
  id            Int         @id @default(autoincrement())
  patient_id    String
  patient       Patient     @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  assessment_id String?
  assessment    Assessment? @relation(fields: [assessment_id], references: [id], onDelete: Cascade)
  leg_side      String      // 'right' | 'left'
  visited_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt

  // --- Clinical Labels (Doctor assigned) ---
  ceap_c String? // C0-C6
  ceap_e String? // Ep, Es, Ec, En
  ceap_a String? // As, Ap, Ad, An
  ceap_p String? // Pr, Po, Pr,o, Pn

  // Raw clinical signs array (JSON) — stored alongside ceap_c so the
  // form can re-populate the checkboxes when an existing patient is loaded.
  // ceap_c remains the authoritative classification; this is the input source.
  clinical_signs String? // JSON Array e.g. ["Active Ulcer", "Pigmentation"]

  // --- rVCSS Component Scores (0-3 each) ---
  pain           Int @default(0)
  varicose_veins Int @default(0)
  edema          Int @default(0)
  pigmentation   Int @default(0)
  inflammation   Int @default(0)
  induration     Int @default(0)
  ulcer_count    Int @default(0)
  ulcer_duration Int @default(0)
  ulcer_size     Int @default(0)
  compression    Int @default(0)

  // --- Patient-Reported ---
  pain_vas Float? // 0-10 VAS scale (moved from Assessment.right_pain_vas/left_pain_vas)

  // --- Bedside Ulcer Exam (collapsed from per-side _r/_l duplicates) ---
  ulcer_present  Boolean @default(false)
  ulcer_location String?
  ulcer_size_cm  Float?
  ulcer_type     String?
  ulcer_edges    String?
  ulcer_base     String?

  // --- Bedside Skin/Swelling ---
  skin_changes   String?
  swelling_grade Int?    // Was String?, now Int? — type normalized

  created_at DateTime @default(now())

  images        Image[]
  doppler       Doppler[]      // Legacy model — no new writes; kept for historical data
  dopplerImages DopplerImage[]

  @@unique([assessment_id, leg_side])
}

// Clinical photograph of the leg (standard photo, not ultrasound)
model Image {
  id          Int      @id @default(autoincrement())
  leg_id      Int
  leg         Leg      @relation(fields: [leg_id], references: [id], onDelete: Cascade)
  file_path   String
  view_type   String   // Front | Medial | Lateral | Posterior
  view_label  String?  // e.g. 'Anterior View', 'Wound Close-Up'
  uploaded_at DateTime @default(now())

  // NOTE: phase, segment, leg_side removed — those are ultrasound-specific
  //       and belong on DopplerImage, not here.
}

// ==============================================================
// Legacy Doppler model — DO NOT write new records to this table.
// Kept only to preserve historical data. Will be fully removed
// in a future cleanup migration.
// ==============================================================
model Doppler {
  id               Int      @id @default(autoincrement())
  leg_id           Int
  leg              Leg      @relation(fields: [leg_id], references: [id], onDelete: Cascade)
  file_path        String
  file_type        String?
  preview_image    String?
  vein_diameter    Float?
  reflux_time      Float?
  vein_type        String?
  deep_vein_status String?
  uploaded_at      DateTime @default(now())
}

// ==============================================================
// AI Data Engine — Each ultrasound image/waveform gets its own row.
// The 1:1 image-to-label mapping is what machine learning requires.
// ==============================================================
model DopplerImage {
  id      Int @id @default(autoincrement())
  leg_id  Int
  leg     Leg @relation(fields: [leg_id], references: [id], onDelete: Cascade)

  // Image Identity
  phase     String  // 'deep' | 'sfj_gsv' | 'spj_ssv' | 'accessory'
  segment   String  // e.g. 'cfv', 'popliteal', 'sfj', 'gsv_mid_thigh'
  view_type String  // 'compression' | 'spectral' | 'diameter' | 'reflux' | 'color_doppler'

  // File Details
  file_path String?
  file_name String?
  file_ext  String? // jpg, png, pdf, dcm, frm

  // AI Training Labels / Doctor Readings
  vein_status      String?  // Doctor label: Normal | Reflux | Obstruction | DVT
  compressible     Boolean? // B-Mode compression finding
  spontaneous_flow Boolean?
  reflux_ms        Float?   // Waveform reflux duration in ms
  reflux_positive  Boolean?
  diameter_mm      Float?   // B-Mode diameter reading
  outward_flow     Boolean?
  doctor_notes     String?  // Free text annotation

  uploaded_at DateTime @default(now())

  // NOTE: leg_side removed — already known via leg_id relation.
}

// ==============================================================
// UHID Sequence — a dedicated auto-increment-only table used purely
// to hand out globally unique, strictly increasing numbers. MySQL's
// AUTO_INCREMENT counter is thread-safe internally, so two doctors
// registering patients at the exact same instant are guaranteed to
// receive two different numbers — no race condition, no manual entry,
// no possibility of duplicate UHIDs.
// ==============================================================
model UhidSequence {
  id Int @id @default(autoincrement())
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  doctor_id   Int?
  doctor_name String?
  action      String   // e.g. "VIEW_PATIENT", "CREATE_ASSESSMENT", "DOWNLOAD_DICOM"
  patient_id  String?
  patient     Patient? @relation(fields: [patient_id], references: [id])
  details     String?  // JSON string of additional context
  timestamp   DateTime @default(now())
}
