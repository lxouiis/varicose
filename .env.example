# ══════════════════════════════════════════════════════════════════════════════
# CEVI Hospital Registry — Environment Configuration Template
#
# Copy this file to .env on the server:
#   cp .env.example .env
#
# Generate high-entropy secrets using openssl:
#   openssl rand -hex 32
# ══════════════════════════════════════════════════════════════════════════════

# Database Passwords (CHANGE FOR PRODUCTION)
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password_here
MYSQL_DATABASE=cevi_db
MYSQL_USER=cevi_app
MYSQL_PASSWORD=replace_with_strong_app_password_here

# Backend Secrets
# Generate a 256-bit random key: openssl rand -hex 32
JWT_SECRET=replace_with_random_jwt_secret_openssl_rand_hex_32

# Network / Origins
PORT=3002
NODE_ENV=production
# Set your hospital server IP or intranet domain (e.g. https://cevi.hospital.local)
ALLOWED_ORIGINS=https://192.168.1.100,http://192.168.1.100,https://cevi.hospital.local

# Frontend API URL (Passed to React build)
VITE_API_URL=https://192.168.1.100/api
