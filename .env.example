# ══════════════════════════════════════════════════════════════════════════════
# CEVI Hospital Registry — Environment Configuration Template
# Hospital Server IP: 10.0.11.244 | Subnet: 255.255.0.0 (/16) | Gateway: 10.0.9.192
#
# Deployment steps:
#   1. cp .env.example .env
#   2. Generate secrets:
#        openssl rand -hex 32   (run once per secret)
#   3. Fill in every value below — the compose file fails fast on any blank secret.
# ══════════════════════════════════════════════════════════════════════════════

# ── Server binding ────────────────────────────────────────────────────────────
# The IP address Nginx will bind to on the host (hospital LAN IP).
# Docker will only expose ports 80/443 on this interface.
SERVER_IP=10.0.11.244

# ── Database credentials ──────────────────────────────────────────────────────
# Generate: openssl rand -hex 20
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password_here
MYSQL_DATABASE=cevi_db
MYSQL_USER=cevi_app
# Generate: openssl rand -hex 20
MYSQL_PASSWORD=replace_with_strong_app_password_here

# ── Backend secrets ───────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32   (must be ≥ 256 bits / 32 bytes)
JWT_SECRET=replace_with_random_jwt_secret_openssl_rand_hex_32

# ── Network / Origins ─────────────────────────────────────────────────────────
PORT=3002
NODE_ENV=production
ALLOWED_ORIGINS=https://10.0.11.244,http://10.0.11.244

# ── Frontend API URL (baked into the React build at docker build time) ─────────
VITE_API_URL=https://10.0.11.244/api
